rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function inHousehold(householdId) {
      return householdId is string && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function inHouseholdAfter(householdId) {
      return householdId is string && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function canReach(list) {
      return inHousehold(list.get('householdId', null)) || request.auth.uid in list.get('members', []);
    }

    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /households/{householdId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members && changes(['names'])) ||
        (!(request.auth.uid in resource.data.members) && changes(['members', 'names']) &&
          request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()) &&
          request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid])) ||
        (request.auth.uid in resource.data.members && changes(['members']) &&
          request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
      );
    }

    match /invites/{code} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      allow create: if signedIn() && code.matches('[A-HJKMNP-Z2-9]{6}') &&
        request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'expiresAt']) &&
        request.resource.data.createdBy == request.auth.uid &&
        inHousehold(request.resource.data.householdId) &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
    }

    match /lists/{listId} {
      allow read: if signedIn() && canReach(resource.data);
      allow create: if signedIn() && inHousehold(request.resource.data.get('householdId', null));
      allow update: if signedIn() && canReach(resource.data) && inHouseholdAfter(request.resource.data.householdId);
      allow delete: if signedIn() && inHousehold(resource.data.get('householdId', null));

      match /{sub}/{docId} {
        allow read, write: if signedIn() && inHousehold(get(/databases/$(database)/documents/lists/$(listId)).data.get('householdId', null));
      }
    }
  }
}
